<?xml version="1.0"?>
<!-- LOCAL TEST ONLY (BNPL-1664): synchronization points of the payment-first finalizer. -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="aplazo_payment_first_convert_before">
        <observer name="localdev_pf_sync" instance="LocalDev\AplazoStub\Observer\SyncPoint"/>
    </event>
    <event name="aplazo_payment_first_order_saved">
        <observer name="localdev_pf_sync" instance="LocalDev\AplazoStub\Observer\SyncPoint"/>
    </event>
    <event name="aplazo_payment_first_cancel_requested">
        <observer name="localdev_pf_sync" instance="LocalDev\AplazoStub\Observer\SyncPoint"/>
    </event>
    <event name="sales_order_load_after">
        <observer name="localdev_pf_sync" instance="LocalDev\AplazoStub\Observer\SyncPoint"/>
    </event>
    <event name="order_cancel_after">
        <observer name="localdev_pf_sync" instance="LocalDev\AplazoStub\Observer\SyncPoint"/>
    </event>
    <event name="aplazo_payment_first_approve_before">
        <observer name="localdev_pf_sync" instance="LocalDev\AplazoStub\Observer\SyncPoint"/>
    </event>
    <!-- BNPL-1664 H-1: hold one ordinary cart request with the quote it already read. -->
    <event name="sales_quote_load_after">
        <observer name="localdev_pf_quote_save_pause" instance="LocalDev\AplazoStub\Observer\QuoteSavePause"/>
    </event>
    <event name="model_save_before">
        <observer name="localdev_pf_quote_save_pause" instance="LocalDev\AplazoStub\Observer\QuoteSavePause"/>
    </event>
    <event name="checkout_cart_save_before">
        <observer name="localdev_pf_quote_save_pause" instance="LocalDev\AplazoStub\Observer\QuoteSavePause"/>
    </event>
    <event name="sales_quote_save_before">
        <observer name="localdev_pf_quote_save_pause" instance="LocalDev\AplazoStub\Observer\QuoteSavePause"/>
    </event>
</config>
